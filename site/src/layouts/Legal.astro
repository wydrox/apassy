---
// The layout of a legal page: the terms, the imprint, and the privacy policy of
// Apassy Connect. A draft says so at the top, stays out of search results, and is
// not linked from the footer (scripts/check-site-plans.py checks the link).
//
// A page that is not a draft must not show the marker of a missing owner fact
// (lib/legal.ts): the build fails, so a placeholder cannot go live.
import Page from "./Page.astro";
import { OWNER_TEXT_NEEDED } from "../lib/legal";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  /** The date of this text, YYYY-MM-DD. */
  updated: string;
  /** "Draft — not yet in force" at the top, and no index. */
  draft?: boolean;
}
const { title, description, eyebrow, heading, updated, draft = false } = Astro.props;
const lead = Astro.slots.has("lead") ? await Astro.slots.render("lead") : "";
const body = await Astro.slots.render("default");
if (!draft && (body.includes(OWNER_TEXT_NEEDED) || lead.includes(OWNER_TEXT_NEEDED))) {
  throw new Error(`${Astro.url.pathname}: the page is not a draft but still has ${OWNER_TEXT_NEEDED}`);
}
---
<Page title={title} description={description} noindex={draft}>
  <main class="container">
    {draft && (
      <p class="draft" role="note">
        <strong>Draft — not yet in force.</strong> This text is a proposal for Apassy Connect, which is not on sale.
        It does not apply to anyone. Missing facts are marked <code>{OWNER_TEXT_NEEDED}</code>.
      </p>
    )}
    <header class="head">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="lead"><Fragment set:html={lead} /> Updated {updated}.</p>
    </header>
    <article class="prose"><Fragment set:html={body} /></article>
  </main>
</Page>

<style>
  main { max-width: 820px; padding-top: 72px; padding-bottom: 120px; }
  .draft {
    margin-bottom: 32px; padding: 14px 18px; border-radius: 12px; border: 1px solid color-mix(in srgb, var(--orange) 40%, transparent);
    background: var(--orange-soft); color: var(--ink-2); font-size: 15px;
  }
  .draft strong { color: var(--orange); font-weight: 600; }
  .draft code { font-size: 0.88em; }
  .head { padding-bottom: 36px; border-bottom: 1px solid var(--line); }
  h1 { margin-top: 12px; font-size: clamp(40px, 6vw, 64px); font-weight: 500; letter-spacing: -0.05em; line-height: 1.02; }
  .lead { margin-top: 16px; }
  .prose :global(h2) { margin-top: 48px; font-size: 28px; font-weight: 500; letter-spacing: -0.03em; }
  .prose :global(h3) { margin-top: 28px; font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }
  .prose :global(p) { margin-top: 14px; color: var(--muted); }
  .prose :global(ul), .prose :global(ol) { margin-top: 14px; padding-left: 0; list-style: none; display: grid; gap: 12px; }
  .prose :global(ol) { counter-reset: item; }
  .prose :global(li) { position: relative; padding-left: 22px; color: var(--muted); }
  .prose :global(ul > li::before) { content: ""; position: absolute; left: 4px; top: 0.7em; width: 6px; height: 6px; border-radius: 50%; background: var(--blue); }
  .prose :global(ol > li) { padding-left: 28px; counter-increment: item; }
  .prose :global(ol > li::before) { content: counter(item) "."; position: absolute; left: 0; color: var(--faint); font-variant-numeric: tabular-nums; }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(a) { color: var(--blue); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--blue) 35%, transparent); text-underline-offset: 3px; }
  .prose :global(code) { font-size: 0.88em; padding: 1px 5px; border-radius: 5px; background: var(--surface-2); border: 1px solid var(--edge); color: var(--ink-2); }
  .prose :global(.owner) { font-family: var(--mono); font-size: 0.86em; padding: 1px 6px; border-radius: 5px; background: var(--orange-soft); color: var(--orange); }
  .prose :global(blockquote) { margin-top: 14px; padding: 14px 18px; border-left: 3px solid var(--edge); background: var(--surface-2); border-radius: 0 10px 10px 0; color: var(--ink-2); }
  .prose :global(table) { margin-top: 14px; width: 100%; border-collapse: collapse; font-size: 15px; }
  .prose :global(th), .prose :global(td) { text-align: left; vertical-align: top; padding: 10px 12px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .prose :global(th) { color: var(--ink); font-weight: 600; }
</style>
