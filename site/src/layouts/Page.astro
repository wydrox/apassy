---
import "@fontsource-variable/dm-sans";
import Lockup from "../components/Lockup.astro";
import Mark from "../components/Mark.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import { DOWNLOAD, REPO, VERSION } from "../lib/site";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Before the first paint: content that reveals on scroll starts hidden only with JavaScript. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <header class="site-header" data-header>
      <div class="container bar">
        <a href="/" class="brand" aria-label="apassy home"><Lockup class="lockup" /></a>
        <nav aria-label="Main">
          <a href="/changelog" class="navlink">Changelog</a>
          <a href={DOWNLOAD} class="navlink" data-download>Download</a>
          <a href={REPO} class="pill"><GitHubIcon /> GitHub</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container foot">
        <p class="foot-left">
          <Mark class="foot-mark" />
          <span>apassy {VERSION && `v${VERSION}`}</span>
          <span class="sep">·</span>
          <span>Design of the page was inspired by <a href="https://t3.codes">t3.codes</a></span>
        </p>
        <nav class="foot-links" aria-label="Footer">
          <a href={REPO}>GitHub</a>
          <a href="/changelog">Changelog</a>
          <a href={DOWNLOAD} data-download>Download</a>
          <a href={`${REPO}/tree/main/docs`}>Docs</a>
          <a href={`${REPO}/releases`}>Releases</a>
        </nav>
      </div>
    </footer>

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>

<style is:global>
  :root {
    --sans: "DM Sans Variable", -apple-system, BlinkMacSystemFont, system-ui, "Segoe UI", sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --bg: #fbfbfd;
    --bg-2: #f4f4f6;
    --ink: #0e1820;
    --ink-2: #2b3137;
    --muted: #62666d;
    --faint: #8b8f96;
    --line: rgba(14, 24, 32, 0.09);
    --grid: rgba(14, 24, 32, 0.045);
    --surface: #ffffff;
    --surface-2: #f7f7f9;
    --edge: rgba(14, 24, 32, 0.1);
    --shadow: 0 1px 2px rgba(14, 24, 32, 0.05), 0 12px 32px rgba(14, 24, 32, 0.08);
    --shadow-lg: 0 2px 6px rgba(14, 24, 32, 0.06), 0 30px 80px rgba(14, 24, 32, 0.16);
    --blue: #0a77fe;
    --blue-soft: rgba(10, 119, 254, 0.1);
    --btn-bg: #0e1820;
    --btn-ink: #ffffff;
    --green: #1f8a3c;
    --green-soft: rgba(52, 199, 89, 0.12);
    --orange: #c25400;
    --orange-soft: rgba(255, 149, 0, 0.14);
    --red: #d70015;
    --red-soft: rgba(255, 59, 48, 0.1);
    --indigo: #5856d6;
    --term-bg: #0c0d10;
    --term-ink: #e8e8ea;
    --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
    --container: 1176px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #09090b;
      --bg-2: #0d0e11;
      --ink: #f5f5f7;
      --ink-2: #d9dade;
      --muted: #a0a3a9;
      --faint: #6f737a;
      --line: rgba(255, 255, 255, 0.08);
      --grid: rgba(255, 255, 255, 0.035);
      --surface: #111216;
      --surface-2: #16181c;
      --edge: rgba(255, 255, 255, 0.09);
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.5), 0 16px 40px rgba(0, 0, 0, 0.5);
      --shadow-lg: 0 2px 6px rgba(0, 0, 0, 0.5), 0 40px 100px rgba(0, 0, 0, 0.7);
      --blue: #3b93ff;
      --blue-soft: rgba(59, 147, 255, 0.14);
      --btn-bg: #ffffff;
      --btn-ink: #0e1820;
      --green: #4cd964;
      --green-soft: rgba(76, 217, 100, 0.12);
      --orange: #ffa62b;
      --orange-soft: rgba(255, 166, 43, 0.14);
      --red: #ff5a50;
      --red-soft: rgba(255, 90, 80, 0.12);
      --indigo: #7d7aff;
      --term-bg: #0c0d10;
    }
  }

  * { box-sizing: border-box; margin: 0; }
  html { background: var(--bg); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; scroll-behavior: smooth; }
  body { min-height: 100vh; position: relative; overflow-x: clip; font-size: 16px; line-height: 1.5; }
  /* The grid of the canvas, faded out below the hero. */
  body::before {
    content: ""; position: absolute; inset: 0 0 auto; height: 1400px; z-index: -1; pointer-events: none;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 56px 56px; background-position: center top;
    mask-image: radial-gradient(ellipse 75% 70% at 50% 25%, #000 35%, transparent 100%);
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; height: auto; }
  button { font: inherit; color: inherit; cursor: pointer; }
  code, kbd { font-family: var(--mono); }
  ::selection { background: var(--blue); color: #fff; }
  :focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; border-radius: 6px; }

  .container { width: 100%; max-width: calc(var(--container) + 48px); margin: 0 auto; padding: 0 24px; }

  /* ---- Header ---- */
  .site-header {
    position: sticky; top: 0; z-index: 50; border-bottom: 1px solid transparent;
    transition: background-color 0.3s, border-color 0.3s, backdrop-filter 0.3s;
  }
  .site-header[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 72%, transparent); border-color: var(--line);
    backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand { display: flex; transition: opacity 0.2s; }
  .brand:hover { opacity: 0.75; }
  .lockup { height: 22px; width: auto; display: block; }
  nav { display: flex; align-items: center; gap: 22px; font-size: 14px; }
  .navlink { color: var(--muted); transition: color 0.15s; }
  .navlink:hover { color: var(--ink); }
  .pill {
    display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px;
    border: 1px solid var(--edge); border-radius: 999px; background: var(--surface); font-weight: 500;
    transition: border-color 0.2s, transform 0.2s var(--ease-out);
  }
  .pill:hover { border-color: var(--faint); transform: translateY(-1px); }
  .pill svg { width: 16px; height: 16px; }
  @media (max-width: 560px) { .navlink:first-child { display: none; } }

  /* ---- Sections ---- */
  .section { border-top: 1px solid var(--line); padding: 112px 0; position: relative; }
  .eyebrow {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--faint);
  }
  .h2 {
    font-size: clamp(36px, 5vw, 56px); font-weight: 500; line-height: 1.04; letter-spacing: -0.045em; text-wrap: balance;
  }
  .lead { font-size: clamp(17px, 1.6vw, 20px); line-height: 1.5; color: var(--muted); text-wrap: pretty; }
  .checks { list-style: none; padding: 0; display: grid; gap: 12px; }
  .checks li { display: flex; gap: 10px; align-items: baseline; color: var(--ink-2); }
  .checks li::before {
    content: ""; flex: none; width: 12px; height: 8px; border-left: 1.6px solid var(--green); border-bottom: 1.6px solid var(--green);
    transform: translateY(-3px) rotate(-45deg);
  }

  /* ---- Buttons ---- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 52px; padding: 0 24px;
    border-radius: 12px; font-size: 16px; font-weight: 600; border: 1px solid transparent; white-space: nowrap;
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s, background-color 0.2s, border-color 0.2s, opacity 0.2s;
  }
  .btn:active { transform: scale(0.97); }
  .btn svg { width: 17px; height: 17px; flex: none; }
  .btn-primary { background: var(--btn-bg); color: var(--btn-ink); box-shadow: var(--shadow); }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
  .btn-primary.soon { opacity: 0.55; pointer-events: none; box-shadow: none; }
  .btn-secondary { background: var(--surface); border-color: var(--edge); color: var(--ink); }
  .btn-secondary:hover { border-color: var(--faint); transform: translateY(-2px); }
  .badge {
    font-size: 11px; font-weight: 600; letter-spacing: 0.02em; padding: 2px 7px; border-radius: 999px;
    background: var(--blue-soft); color: var(--blue);
  }

  /* ---- Cards with a spotlight that follows the pointer (scripts/site.ts) ---- */
  .card {
    position: relative; border: 1px solid var(--edge); border-radius: 18px; background: var(--surface); overflow: hidden;
  }
  [data-spotlight]::after {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.3s;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), var(--blue-soft), transparent 60%);
  }
  [data-spotlight]:hover::after { opacity: 1; }

  /* ---- Reveal on scroll (scripts/site.ts). Without JavaScript, all is visible. ---- */
  .js [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out); transition-delay: calc(var(--i, 0) * 90ms); }
  .js [data-reveal].is-visible { opacity: 1; transform: none; }

  /* ---- Footer ---- */
  .site-footer { border-top: 1px solid var(--line); background: var(--bg-2); }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 16px 32px; flex-wrap: wrap; padding-top: 28px; padding-bottom: 28px; font-size: 13px; color: var(--faint); }
  .foot-left { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .foot-left a { color: var(--muted); text-decoration: underline; text-decoration-color: var(--edge); text-underline-offset: 3px; transition: color 0.15s; }
  .foot-left a:hover { color: var(--ink); }
  .foot-mark { width: 16px; height: auto; color: var(--ink); }
  .foot-links { gap: 20px; font-size: 13px; flex-wrap: wrap; }
  .foot-links a { color: var(--muted); transition: color 0.15s; }
  .foot-links a:hover { color: var(--ink); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
    .js [data-reveal] { opacity: 1; transform: none; }
  }
</style>
