---
// The cancel page of a Connect checkout (implementation plan s7, decision 3).
import Notice from "../../components/connect/Notice.astro";
---
<Notice
  title="Checkout canceled · Apassy Connect"
  description="Nothing was charged. Return to Apassy on your Mac."
  heading="Checkout canceled."
>
  <p>Nothing was charged, and your plan did not change. You can start again in Apassy on your Mac at any time.</p>
  <a class="btn btn-primary" href="apassy://connect/cancel">Return to Apassy</a>
  <p class="small">
    If Apassy does not open, open it yourself: <kbd>Settings</kbd> › <kbd>Connect</kbd>. Everything that you host
    yourself stays free. <a href="/pricing">Pricing</a>
  </p>
</Notice>
