---
// The invite page of a Connect Family or Connect Team (implementation plan s7,
// decision 3): https://apassy.wyderka.cc/connect/join#<code>. The code is in the
// fragment, so the browser never sends it to this site. The page only says how
// to use the invite and copies the link; it never reads or shows the code. The Mac
// app registers no URL scheme: the person pastes the link in the app.
import Notice from "../../components/connect/Notice.astro";
---
<Notice
  title="Join a family or a team · Apassy Connect"
  description="Open Apassy on your Mac to join."
  heading="You are invited to Apassy Connect."
>
  <p>
    Someone invited you to their Connect Family or Connect Team. Copy this link, then open Apassy on your Mac:
    <kbd>Settings</kbd> › <kbd>Connect</kbd> › <kbd>Join a Family or Team</kbd>, and paste the link there.
  </p>
  <div class="copy-row">
    <button class="btn btn-primary" type="button" data-copy="" data-invite>
      <span data-copy-label>Copy the invite link</span>
    </button>
    <span class="sr-only" aria-live="polite" data-copy-status></span>
  </div>
  <p class="small">
    The invite works once and ends after 7 days. The organizer confirms you before you join. Joining adds no device:
    you confirm each device on one that you already have.
  </p>
  <p class="small">No Apassy yet? <a href="/">Get Apassy for your Mac</a>, then come back to this link.</p>
</Notice>

<script>
  // The copy button of scripts/site.ts copies data-copy: set it to this address.
  // Without a code in the fragment there is nothing to copy.
  const button = document.querySelector<HTMLButtonElement>("[data-invite]");
  if (button) {
    if (window.location.hash.length > 1) button.dataset.copy = window.location.href;
    else button.hidden = true;
  }
</script>

<style>
  .copy-row { margin-top: 4px; }
</style>
