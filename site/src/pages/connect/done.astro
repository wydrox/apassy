---
// The success page of a Connect checkout (implementation plan s7, decision 3):
// Stripe returns here with ?session_id={CHECKOUT_SESSION_ID}. The page holds no
// secret and calls no API. The plan comes to the Mac from the Stripe webhook, not
// from this page: Apassy on the Mac asks Apassy Connect every few seconds while
// it waits. The Mac app registers no URL scheme, so there is no link back to it.
import Notice from "../../components/connect/Notice.astro";
---
<Notice
  title="Payment received · Apassy Connect"
  description="Apassy on your Mac shows your plan in a moment."
  heading="Thank you. Your plan is on its way."
>
  <p>Apassy on your Mac shows your plan in a moment. You can close this page.</p>
  <p class="small">
    Your plan is in Apassy on your Mac: <kbd>Settings</kbd> › <kbd>Connect</kbd>. Stripe sends the receipt by
    e-mail.
  </p>
</Notice>

<script>
  // The session id is not a secret, but it need not stay in the address bar or the history.
  if (window.location.search) window.history.replaceState(null, "", window.location.pathname);
</script>
