---
import Page from "../layouts/Page.astro";
import Hero from "../components/Hero.astro";
import Agents from "../components/Agents.astro";
import Bouncer from "../components/Bouncer.astro";
import Placeholders from "../components/Placeholders.astro";
import Gallery from "../components/Gallery.astro";
import Proof from "../components/Proof.astro";
import Source from "../components/Source.astro";
import Closing from "../components/Closing.astro";
---
<Page
  title="apassy · A credential manager for you and your agents"
  description="Agents get access. Never your secrets. Store credentials on your Mac, write plain-language rules, and let a local bouncer check every agent request."
>
  <main>
    <Hero />
    <Agents />
    <Bouncer />
    <Placeholders />
    <Gallery />
    <Proof />
    <Source />
    <Closing />
  </main>
</Page>
