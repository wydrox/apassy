<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Xcode automatic signing reads this file. The keychain access group makes
  Xcode register the App ID and create a development provisioning profile.
  Keep the group equal to packaging/ApassyKeychain.entitlements.
-->
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.wydrox.apassy</string>
	</array>
</dict>
</plist>
