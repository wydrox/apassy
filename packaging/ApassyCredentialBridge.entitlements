<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of Apassy.app/Contents/MacOS/apassy-credential-bridge
  (com.wydrox.apassy.credential-bridge). Only the app group with the team prefix:
  on macOS it is not restricted and needs no provisioning profile, and macOS 15
  container protection lets a program of the same team use the group container.
  The bridge is not sandboxed. It has no AutoFill entitlement: it does not touch the
  identity store.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>__TEAM_ID__.com.wydrox.apassy</string>
	</array>
</dict>
</plist>
