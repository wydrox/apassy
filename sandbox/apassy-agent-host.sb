;; Apassy agent-host isolation profile (macOS Seatbelt / SBPL).
;;
;; Goal: an agent host (Claude Code, Codex) and every command it starts cannot
;; read, copy, or replace Apassy's protected files. The host can still connect
;; to the broker socket, so `apassy-mcp` keeps working. Everything else stays
;; usable for normal development: git, cargo, npm, the network, and the host's
;; own configuration and credentials.
;;
;; The profile denies read and write to:
;;   - the Apassy data directory (vaults, vault list, broker socket, Laya model),
;;   - the vault file and its SQLite companions,
;;   - each other vault file in the vault list outside the data directory, and
;;     its SQLite companions,
;;   - the backup file and its SQLite companions,
;;   - the Apassy folder in iCloud Drive (the synced vault copies), when given,
;;   - each synced vault file in another folder (Dropbox, a share), its push
;;     temporary file, and its SQLite companions. The rest of that folder stays
;;     usable.
;; It re-allows a connection to the broker socket, which lives inside the
;; denied data directory.
;;
;; The profile also denies the start, the read, and a change of the programs
;; in the Apassy app bundle: the desktop app and the native helpers (Touch ID,
;; keychain, notifications). A process in the profile cannot start a helper,
;; copy it, or link it. It re-allows only `Contents/MacOS/apassy-mcp` and
;; `Contents/MacOS/apassy-hook`, because the agent host starts them.
;;
;; The profile also denies each route that starts a program OUTSIDE the
;; sandbox as the same user, because that program is not confined and can read
;; the vault: LaunchServices (`open`/`lsopen`), Apple Events, the Shortcuts and
;; Automator services, a write to an autostart location (LaunchAgents,
;; LaunchDaemons, login items, application scripts, and shell startup files),
;; a write to a NativeMessagingHosts folder of a browser, and a change of the
;; settings of a browser profile.
;; The measurements are in docs/operations/isolation.md.
;;
;; Parameters (pass with `sandbox-exec -D KEY=VALUE`). Use absolute, resolved
;; paths. A path with spaces is fine; the profile quotes each value.
;;   APASSY_DATA_DIR    the Apassy data directory, for example
;;                      "$HOME/Library/Application Support/Apassy"
;;   APASSY_VAULT_FILE  the vault database file
;;   APASSY_VAULT_FILE_2 to APASSY_VAULT_FILE_16
;;                      more vault files from the vault list
;;                      (<data dir>/vaults.json) that are outside the data
;;                      directory. Optional. The launcher passes one for each
;;                      such vault and stops when the list has more than 15.
;;   APASSY_BACKUP_FILE the backup database file
;;   APASSY_SOCKET      the broker Unix socket
;;   APASSY_HOME        the owner home directory. The profile denies a write to
;;                      the autostart locations under it.
;;   APASSY_APP         the installed app bundle. Optional. Default:
;;                      "/Applications/Apassy.app"
;;   APASSY_APP_BUILD   a second app bundle, for example the build output
;;                      "<repository>/target/Apassy.app". Optional.
;;   APASSY_CLOUD_DIR   the Apassy folder in iCloud Drive, for example
;;                      "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Apassy".
;;                      Optional. The profile denies read and write under it.
;;   APASSY_SYNC_FILE_1 to APASSY_SYNC_FILE_16
;;                      the synced vault files of the vault list that are outside
;;                      the data directory and the iCloud Apassy folder, for
;;                      example "$HOME/Dropbox/Apassy/Work.apassy". Optional. The
;;                      launcher passes one for each and stops when there are more
;;                      than 16.
;;
;; Limits: Seatbelt does not protect memory, the clipboard, or processes that
;; run outside this profile. A program that the owner runs later, for example
;; from a project git hook or a Makefile, is not confined; the profile cannot
;; close every such route. Apple marks `sandbox-exec` as deprecated.

(version 1)

;; Start from the normal user environment. The denials below carve the
;; protected paths out of it.
(allow default)

;; --- Helpers -------------------------------------------------------------

;; The parent directories of PATH, from the shallowest to "PATH minus the last
;; segment". The list does not include PATH itself or the root "/".
;; Example: "/a/b/c" gives ("/a" "/a/b").
(define (apassy-ancestors path)
  (let loop ((i (- (string-length path) 1)) (acc '()))
    (cond ((<= i 0) acc)
          ((char=? (string-ref path i) #\/)
           (loop (- i 1) (cons (substring path 0 i) acc)))
          (else (loop (- i 1) acc)))))

;; Deny a rename or a delete of each parent directory of PATH. Without this a
;; sandboxed process can rename a parent directory and then read the protected
;; file at its new, un-denied path. A subpath deny blocks a rename of the
;; denied directory itself, but not a rename of a directory above it.
(define (apassy-seal-ancestors path)
  (for-each
    (lambda (dir) (deny file-write-unlink (literal dir)))
    (apassy-ancestors path)))

;; Deny read and write to PATH and to the SQLite sidecar files that a vault or
;; a backup can have next to it.
(define (apassy-deny-db path)
  (deny file-read* file-write* (literal path))
  (deny file-read* file-write* (literal (string-append path "-wal")))
  (deny file-read* file-write* (literal (string-append path "-shm")))
  (deny file-read* file-write* (literal (string-append path "-journal")))
  (deny file-read* file-write* (literal (string-append path ".lock"))))

;; Deny read and write under the directory DIR, and a rename or a delete of its
;; parent directories.
(define (apassy-deny-tree dir)
  (deny file-read* file-write* (subpath dir))
  (apassy-seal-ancestors dir))

;; --- Denials -------------------------------------------------------------

;; The Apassy data directory holds the vault, the broker socket, the owner
;; socket, and the Laya model at <data dir>/laya. Deny the whole subtree.
(deny file-read* file-write* (subpath (param "APASSY_DATA_DIR")))
(apassy-seal-ancestors (param "APASSY_DATA_DIR"))

;; A connect to a Unix socket is not a file read or write, so the rule above
;; does not stop it (measured on 2026-10-01). Deny every socket in the data
;; directory: the owner socket of the command line (ADR 0017) is there, and an
;; agent must never reach it. The broker socket is re-allowed below.
(deny network-outbound (remote unix-socket (subpath (param "APASSY_DATA_DIR"))))

;; The vault file. The owner can place it outside the data directory.
(apassy-deny-db (param "APASSY_VAULT_FILE"))
(apassy-seal-ancestors (param "APASSY_VAULT_FILE"))

;; The other vaults of the vault list (ADR 0013). A vault in the data directory
;; is already in the subtree deny. The launcher passes each vault outside it as
;; one of these parameters. An absent parameter adds no rule.
(define (apassy-protect-vault path)
  (apassy-deny-db path)
  (apassy-seal-ancestors path))
(if (param "APASSY_VAULT_FILE_2") (apassy-protect-vault (param "APASSY_VAULT_FILE_2")))
(if (param "APASSY_VAULT_FILE_3") (apassy-protect-vault (param "APASSY_VAULT_FILE_3")))
(if (param "APASSY_VAULT_FILE_4") (apassy-protect-vault (param "APASSY_VAULT_FILE_4")))
(if (param "APASSY_VAULT_FILE_5") (apassy-protect-vault (param "APASSY_VAULT_FILE_5")))
(if (param "APASSY_VAULT_FILE_6") (apassy-protect-vault (param "APASSY_VAULT_FILE_6")))
(if (param "APASSY_VAULT_FILE_7") (apassy-protect-vault (param "APASSY_VAULT_FILE_7")))
(if (param "APASSY_VAULT_FILE_8") (apassy-protect-vault (param "APASSY_VAULT_FILE_8")))
(if (param "APASSY_VAULT_FILE_9") (apassy-protect-vault (param "APASSY_VAULT_FILE_9")))
(if (param "APASSY_VAULT_FILE_10") (apassy-protect-vault (param "APASSY_VAULT_FILE_10")))
(if (param "APASSY_VAULT_FILE_11") (apassy-protect-vault (param "APASSY_VAULT_FILE_11")))
(if (param "APASSY_VAULT_FILE_12") (apassy-protect-vault (param "APASSY_VAULT_FILE_12")))
(if (param "APASSY_VAULT_FILE_13") (apassy-protect-vault (param "APASSY_VAULT_FILE_13")))
(if (param "APASSY_VAULT_FILE_14") (apassy-protect-vault (param "APASSY_VAULT_FILE_14")))
(if (param "APASSY_VAULT_FILE_15") (apassy-protect-vault (param "APASSY_VAULT_FILE_15")))
(if (param "APASSY_VAULT_FILE_16") (apassy-protect-vault (param "APASSY_VAULT_FILE_16")))

;; The backup file. The owner can place it outside the data directory.
(apassy-deny-db (param "APASSY_BACKUP_FILE"))
(apassy-seal-ancestors (param "APASSY_BACKUP_FILE"))

;; The Apassy folder in iCloud Drive. It holds a closed, encrypted copy of each
;; synced vault. A process with such a copy can try passphrases offline, and a
;; changed copy can reach the other Macs. Optional, so a profile call without it
;; still works; the launcher passes it by default.
(if (param "APASSY_CLOUD_DIR")
  (apassy-deny-tree (param "APASSY_CLOUD_DIR")))

;; The synced vault files in other folders (ADR 0014, docs/operations/sync.md).
;; Only the file is closed, not the folder: an agent's projects can live in
;; Dropbox too. A process with the file can guess passphrases offline, and a
;; changed file can reach the other Macs. The push writes
;; `<file>.push.nosync` first, then renames it.
(define (apassy-protect-sync-file path)
  (apassy-deny-db path)
  (deny file-read* file-write* (literal (string-append path ".push.nosync")))
  (apassy-seal-ancestors path))
(if (param "APASSY_SYNC_FILE_1") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_1")))
(if (param "APASSY_SYNC_FILE_2") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_2")))
(if (param "APASSY_SYNC_FILE_3") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_3")))
(if (param "APASSY_SYNC_FILE_4") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_4")))
(if (param "APASSY_SYNC_FILE_5") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_5")))
(if (param "APASSY_SYNC_FILE_6") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_6")))
(if (param "APASSY_SYNC_FILE_7") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_7")))
(if (param "APASSY_SYNC_FILE_8") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_8")))
(if (param "APASSY_SYNC_FILE_9") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_9")))
(if (param "APASSY_SYNC_FILE_10") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_10")))
(if (param "APASSY_SYNC_FILE_11") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_11")))
(if (param "APASSY_SYNC_FILE_12") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_12")))
(if (param "APASSY_SYNC_FILE_13") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_13")))
(if (param "APASSY_SYNC_FILE_14") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_14")))
(if (param "APASSY_SYNC_FILE_15") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_15")))
(if (param "APASSY_SYNC_FILE_16") (apassy-protect-sync-file (param "APASSY_SYNC_FILE_16")))

;; --- The Apassy app bundle ------------------------------------------------

;; The programs in the bundle that the agent host must start.
(define apassy-agent-programs '("apassy-mcp" "apassy-hook"))

;; Protect the app bundle APP:
;; - No program in the bundle starts in the profile. The keychain helper and
;;   `apassy-helper` can show a Touch ID prompt and post a notification with
;;   the text of the caller. With a provisioning profile, the keychain helper
;;   can also return the Touch ID unlock key.
;; - No read and no write in the bundle. So a process cannot copy, clone, or
;;   hard-link a helper (with its signature and its provisioning profile) to
;;   a path that the profile does not deny, and cannot change the bundle.
;; - No rename or delete of a parent directory, so the bundle cannot move out
;;   of the denied path.
;; - Then re-allow the start and the read of `apassy-mcp` and `apassy-hook`
;;   in `Contents/MacOS`, and the metadata of the directories on their path.
;;   A later rule wins in SBPL.
(define (apassy-protect-app app)
  (deny process-exec* (subpath app))
  (deny file-read* file-write* (subpath app))
  (apassy-seal-ancestors app)
  (for-each
    (lambda (name)
      (allow process-exec* file-read*
        (literal (string-append app "/Contents/MacOS/" name))))
    apassy-agent-programs)
  (allow file-read-metadata
    (literal app)
    (literal (string-append app "/Contents"))
    (literal (string-append app "/Contents/MacOS"))))

(apassy-protect-app (or (param "APASSY_APP") "/Applications/Apassy.app"))
(if (param "APASSY_APP_BUILD")
  (apassy-protect-app (param "APASSY_APP_BUILD")))

;; --- Re-allow the broker socket -----------------------------------------

;; The socket lives inside the denied data directory. A later rule wins in
;; SBPL, so this re-opens only the socket node. The host and `apassy-mcp` can
;; connect; they still cannot read any other file in the data directory.
(allow network-outbound (remote unix-socket (path-literal (param "APASSY_SOCKET"))))
(allow file-read* file-write* (literal (param "APASSY_SOCKET")))

;; --- No start of a program outside the sandbox --------------------------

;; A process in the profile must not start a program that runs OUTSIDE the
;; sandbox as the same user. That program is not confined, so it can read the
;; vault. The rules below deny each measured route. The routes, the controls,
;; and the results are in docs/operations/isolation.md, section "Launching
;; outside the sandbox". These rules win because SBPL takes the last match and
;; `(allow default)` is the first rule.

;; LaunchServices. `open` and the `lsopen` operation start an application, a
;; `.command` or `.tool` script, or a URL scheme handler. The started program
;; runs outside the sandbox. A measurement started an application bundle this
;; way and it read the vault canary. Deny the operation. A filter on the URL
;; or the path does not match here, so the deny is total. So `open https://…`
;; also fails; the owner runs a browser login flow outside the profile. A
;; program still starts normally, because a normal start uses `process-exec`,
;; not `lsopen`.
(deny lsopen)

;; Apple Events. `osascript` or any automation can tell another application,
;; for example Terminal with `do script` or System Events, to run code. The
;; other application runs outside the sandbox. A measurement showed that a send
;; reaches a running application. Deny the send.
(deny appleevent-send)

;; Shortcuts and Automator run a "Run Shell Script" action in a helper outside
;; the sandbox. Deny a lookup of their services. Normal development does not
;; use them. `open` of the apps is already denied by `lsopen`.
(deny mach-lookup
  (global-name-regex #"[Ss]hortcut")
  (global-name-regex #"WorkflowKit"))

;; Autostart locations. launchd starts a LaunchAgent or a LaunchDaemon outside
;; the sandbox at the next load or the next login. A login item, an application
;; script, and a shell startup file also start outside the sandbox. A
;; measurement wrote a LaunchAgent plist and launchd then ran it and read the
;; vault canary. Deny a write to each autostart location, so a process in the
;; profile cannot plant one. The deny is on writes only, so a shell still reads
;; (sources) its startup files, and a tool still reads them. `APASSY_HOME` is
;; the owner home directory; a test points it at a temporary home.
(define (apassy-deny-autostart home)
  (for-each
    (lambda (dir) (deny file-write* (subpath (string-append home dir))))
    '("/Library/LaunchAgents"
      "/Library/LaunchDaemons"
      "/Library/Application Scripts"
      "/Library/Application Support/com.apple.backgroundtaskmanagementagent"))
  (for-each
    (lambda (file) (deny file-write* (literal (string-append home file))))
    '("/Library/Preferences/com.apple.loginitems.plist"
      "/.zshenv" "/.zprofile" "/.zshrc" "/.zlogin" "/.zlogout"
      "/.bashrc" "/.bash_profile" "/.bash_login" "/.profile")))

(apassy-deny-autostart (param "APASSY_HOME"))

;; Native messaging hosts. When an extension connects to a native messaging
;; host, the browser starts the program of the host manifest outside the
;; sandbox. A process in the profile that writes a manifest can replace the host
;; of an installed extension, for example the host of the Apassy extension, and
;; read what passes through it: the password of a fill after the owner's Touch
;; ID (ADR 0021). Deny a write to each NativeMessagingHosts folder, at any path:
;; each Chromium browser and each profile folder has one, and Firefox has one
;; too. The pattern also denies the creation and the rename of such a folder,
;; so a folder with another name cannot become one.
(deny file-write* (regex #"/NativeMessagingHosts(/|$)"))

;; The profiles of the Chromium browsers that `apassy setup browser` knows. A
;; profile keeps the folder of each unpacked extension in Preferences and
;; Secure Preferences. A Chromium build has no secret seed for the check of
;; Secure Preferences, so a process in the profile could point the ID of the
;; Apassy extension at a folder of its own, and the browser would run that code
;; at its next start (ADR 0021). Deny a write to these files and to Local State
;; (the list of profiles), and the creation, the rename, and the delete of a
;; browser folder and of each folder and file directly in it, so a prepared
;; profile cannot replace the real one. Files inside a profile stay writable.
;; A browser that a process in the profile starts with one of these real
;; profile folders cannot start; a temporary profile folder works.
(deny file-write*
  (regex #"/Library/Application Support/(net\.imput\.helium|Google/Chrome[^/]*|Chromium|BraveSoftware/Brave-Browser[^/]*|Microsoft Edge[^/]*|Arc/User Data|Vivaldi)/([^/]+/(Secure )?Preferences|Local State)$"))
(deny file-write-create file-write-unlink
  (regex #"/Library/Application Support/(net\.imput\.helium|Google/Chrome[^/]*|Chromium|BraveSoftware/Brave-Browser[^/]*|Microsoft Edge[^/]*|Arc/User Data|Vivaldi)(/[^/]+)?$")
  (regex #"/Library/Application Support/(Google|BraveSoftware|Arc)$"))
