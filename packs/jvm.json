{
  "schema_version": 1,
  "pack_version": 3,
  "tool": "jvm",
  "description": "Gradle and Maven: Flyway and Liquibase tasks that drop or revert, publishing and deployment, and build, test, and check tasks.",
  "programs": ["gradle", "gradlew", "mvn", "mvnw"],
  "roles": {
    "usage": ["gradle", "gradlew", "mvn", "mvnw"],
    "project_code": ["gradle", "gradlew", "mvn", "mvnw"]
  },
  "rules": [
    {
      "id": "database-clean-or-rollback",
      "flag": "data_loss",
      "note": "The Flyway and Liquibase plugin tasks `clean`, `undo`, `dropAll`, and `rollback` drop objects or revert migrations.",
      "when": {
        "any_arg": [
          "flywayclean", "flyway:clean", "flywayundo", "flyway:undo", "liquibase:dropall",
          "dropall", "liquibase:rollback", "rollback", "rollbackcount", "rollbacktodate"
        ]
      }
    },
    {
      "id": "database-history-change",
      "flag": "irreversible",
      "note": "The Flyway plugin tasks `repair` and `baseline` and the Liquibase task `changelogSync` change the migration history without running migrations.",
      "when": {
        "any_arg": [
          "flywayrepair", "flyway:repair", "flywaybaseline", "flyway:baseline",
          "liquibase:changelogsync", "changelogsync", "liquibase:clearchecksums"
        ]
      }
    },
    {
      "id": "publish-or-deploy",
      "flag": "production",
      "dry_run": "skip",
      "note": "`publish`, `deploy`, and release tasks upload artifacts or images, or deploy an app. `publishToMavenLocal` stays on this machine.",
      "when": {
        "not": { "any_arg": ["publishtomavenlocal"] },
        "any_of": [
          { "any_arg": ["publish", "deploy", "release:perform", "jib", "appenginedeploy", "bootbuildimage:publish"] },
          { "any_arg_starts": ["publish", "deploy:", "jib:"] },
          { "any_arg_contains": [":publish"] }
        ]
      }
    }
  ],
  "safe": [
    {
      "id": "build-test-and-check",
      "note": "Every task is a build, test, check, format, or report task, also with a module path such as `:app:test`. Tests and build plugins are project code with a check or build contract. The Flyway and Liquibase plugin tasks `info`, `validate`, and `status` only read. The value of options such as `--tests` or `-x` is not a task. `run`, `bootRun`, and `spring-boot:run` are not here: they run the program of the project with any effect (dev round 3).",
      "when": {
        "operands": {
          "skip": [
            "--tests", "-x", "--exclude-task", "-p", "--project-dir", "-pl", "--projects",
            "-f", "--file", "--settings", "--init-script"
          ],
          "all": [
            {
              "equals": [
                "clean", "build", "test", "check", "assemble", "compile", "compilejava",
                "compilekotlin", "lint", "verify", "package", "validate", "install",
                "dependencies", "tasks", "javadoc", "spotlesscheck", "spotlessapply",
                "ktlintcheck", "ktlintformat", "detekt", "jacocotestreport", "test-compile", "surefire:test", "dependency:tree",
                "checkstyle:check", "spotbugs:check", "pmd:check", "help", "flywayinfo",
                "flyway:info", "flywayvalidate", "flyway:validate", "liquibase:status",
                "liquibase:validate", "liquibase:history"
              ]
            },
            {
              "starts": [":"],
              "ends": [
                ":clean", ":build", ":test", ":check", ":assemble", ":lint", ":dependencies",
                ":detekt"
              ]
            }
          ]
        }
      }
    }
  ],
  "writes": [
    {
      "id": "database-migrate",
      "note": "The Flyway and Liquibase plugin tasks `migrate` and `update` change the database.",
      "when": {
        "any_arg": [
          "flywaymigrate", "flyway:migrate", "liquibase:update", "update", "updatecount",
          "updatetotag"
        ]
      }
    }
  ]
}
