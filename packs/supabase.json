{
  "schema_version": 1,
  "pack_version": 3,
  "tool": "supabase",
  "description": "Supabase CLI: database queries and resets, key listings, functions, secrets, and local development.",
  "programs": ["supabase"],
  "roles": {
    "usage": ["supabase"],
    "heredoc_sql": ["supabase"]
  },
  "rules": [
    {
      "id": "api-keys",
      "flag": "secret_output",
      "note": "The key listing prints the service role key.",
      "when": { "args_start": ["projects api-keys"] }
    },
    {
      "id": "credential-columns",
      "flag": "secret_output",
      "note": "A query that reads password hashes, tokens, or keys prints credentials.",
      "when": {
        "command_contains": [
          "encrypted_password", "password_hash", "recovery_token", "api_key", "secret_key",
          "refresh_token", "access_token"
        ]
      }
    },
    {
      "id": "query-write",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "A `db query` that changes data, schema, or access.",
      "when": { "args_start": ["db query"], "sql": "writes" }
    },
    {
      "id": "reset-and-delete",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "A database reset, and deletion of projects, functions, or storage objects.",
      "when": {
        "any_of": [
          { "args_start": ["db reset", "projects delete", "functions delete"] },
          { "args_contain": ["storage rm", "--accept-data-loss"] }
        ]
      }
    },
    {
      "id": "remote-release",
      "flag": "production",
      "dry_run": "skip",
      "note": "Function deploys, secret changes, and a push to the linked project change the hosted project.",
      "when": {
        "any_of": [
          { "args_start": ["functions deploy", "secrets set", "secrets unset"] },
          { "args_start": ["db push"], "args_contain": ["--linked"] }
        ]
      }
    }
  ],
  "safe": [
    {
      "id": "read-query",
      "note": "A `db query` with read statements only.",
      "when": { "args_start": ["db query"], "sql": "reads" }
    },
    {
      "id": "local-and-read-commands",
      "note": "The local stack, linters, type generation, and listings. `link` stores the database password of the project, and `stop --no-backup` deletes the local data, so they are not here (dev round 3).",
      "when": {
        "args_start": [
          "db lint", "db advisors", "branches list", "projects list", "migration list",
          "inspect", "status", "start", "stop", "gen types", "migration new", "db diff",
          "functions serve", "--version"
        ],
        "not": { "any_arg": ["--no-backup"] }
      }
    }
  ]
}
