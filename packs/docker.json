{
  "schema_version": 1,
  "pack_version": 3,
  "tool": "docker",
  "description": "Docker, Podman, and Compose: removal of containers, images, and volumes, host access from a container, printed Compose configuration, image runs, pushes, and read and local commands.",
  "programs": ["docker", "podman", "docker-compose", "podman-compose"],
  "roles": {
    "usage": ["docker"]
  },
  "rules": [
    {
      "id": "secret-argument",
      "flag": "secret_output",
      "note": "A secret in an argument goes to the container or to the image history.",
      "when": { "program": ["docker"], "refs_secret": true }
    },
    {
      "id": "remove-data",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "Removal of containers, images, and volumes. A volume can hold a local database.",
      "when": {
        "program": ["docker", "podman"],
        "any_of": [
          { "args_contain": ["system prune", "volume rm", "volume prune"] },
          { "args_start": ["rm ", "rmi"] },
          { "args_contain": ["compose down"], "any_arg": ["-v", "--volumes"] }
        ]
      }
    },
    {
      "id": "compose-down-volumes",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "`down -v` removes the named volumes of the project.",
      "when": {
        "program": ["docker-compose", "podman-compose"],
        "subcommand": ["down"],
        "any_arg": ["-v", "--volumes"]
      }
    },
    {
      "id": "host-access",
      "flag": "privilege",
      "note": "A privileged container, the Docker socket, or a mount of `/`, the home folder, or a credential folder gives the container the owner's machine or keys.",
      "when": {
        "any_of": [
          { "any_arg": ["--privileged", "--pid=host", "--userns=host", "--cap-add=all"] },
          { "any_arg_contains": ["docker.sock"] },
          {
            "any_arg_starts": [
              "/:", "$home:", "${home}:", "$home/:", "${home}/:", "~:", "~/:"
            ]
          },
          {
            "any_arg_contains": [
              "/.ssh:", "/.aws:", "/.kube:", "/.gnupg:", "/.docker:", "/.config/gcloud:",
              "/.azure:", "source=/,", "src=/,", "source=$home,", "src=$home,",
              "source=${home},", "src=${home},", "source=~,", "src=~,"
            ]
          }
        ]
      }
    },
    {
      "id": "compose-config-values",
      "flag": "secret_output",
      "note": "`compose config` prints the Compose file with the values of the environment and of `.env` in it, secrets included. `--no-interpolate` and the lists of names do not print values (dev round 3).",
      "when": {
        "any_of": [
          { "program": ["docker", "podman"], "subcommand": ["compose"], "action": ["config", "convert"] },
          { "program": ["docker-compose", "podman-compose"], "subcommand": ["config", "convert"] }
        ],
        "not": {
          "any_arg": [
            "--no-interpolate", "-q", "--quiet", "--services", "--volumes", "--profiles",
            "--images", "--networks"
          ]
        }
      }
    }
  ],
  "safe": [
    {
      "id": "read-build-and-compose",
      "note": "Reads, local builds, and the local Compose project. `inspect` of a container prints its environment, and a build with `--push` uploads the image, so they are not here (dev round 3).",
      "when": {
        "program": ["docker", "podman"],
        "not": { "any_arg": ["--push"] },
        "any_of": [
          { "subcommand": ["ps", "images", "logs", "version", "info", "build"] },
          {
            "subcommand": ["compose"],
            "action": ["ps", "logs", "up", "build", "stop", "restart"]
          }
        ]
      }
    },
    {
      "id": "list-commands",
      "note": "Listings of local images, containers, volumes, and networks, and inspection of images, volumes, and networks. The inspection of a container prints its environment, so it is not here.",
      "when": {
        "program": ["docker", "podman"],
        "any_of": [
          {
            "subcommand": ["image", "volume", "network", "context"],
            "action": ["ls", "list", "inspect"]
          },
          { "subcommand": ["container"], "action": ["ls", "list"] },
          { "subcommand": ["compose"], "action": ["images", "top", "ls", "version"] }
        ]
      }
    },
    {
      "id": "compose-down-keep-volumes",
      "note": "`down` without `-v` or `--rmi` stops the local project and keeps its data.",
      "when": {
        "any_of": [
          { "program": ["docker", "podman"], "subcommand": ["compose"], "action": ["down"] },
          { "program": ["docker-compose", "podman-compose"], "subcommand": ["down"] }
        ],
        "not": { "any_arg": ["-v", "--volumes", "--rmi"] }
      }
    },
    {
      "id": "command-in-local-container",
      "note": "`exec` and `compose run` start a command in a local container. The analysis checks that command like a command on the host, so the whole line is safe only when the inner command is safe. Without a command, the container runs its default command, which the project defines: the analysis treats it as project code (dev round 3).",
      "when": {
        "any_of": [
          { "program": ["docker", "podman"], "subcommand": ["exec"] },
          { "program": ["docker", "podman"], "subcommand": ["container"], "action": ["exec"] },
          { "program": ["docker", "podman"], "subcommand": ["compose"], "action": ["exec", "run"] },
          { "program": ["docker-compose", "podman-compose"], "subcommand": ["exec", "run"] }
        ]
      }
    }
  ],
  "project_commands": [
    {
      "id": "image-run",
      "note": "`docker run` runs the code of an image, often from a registry. The analysis cannot check it, so it is not a known command (dev round 3).",
      "when": {
        "program": ["docker", "podman"],
        "any_of": [{ "subcommand": ["run"] }, { "subcommand": ["container"], "action": ["run"] }]
      }
    }
  ],
  "writes": [
    {
      "id": "push",
      "note": "A push uploads an image to a registry. A build with `--push` or a registry output does the same.",
      "when": {
        "any_of": [
          { "program": ["docker", "podman"], "subcommand": ["push"] },
          { "program": ["docker", "podman"], "subcommand": ["image", "manifest", "compose", "buildx"], "action": ["push"] },
          { "program": ["docker-compose", "podman-compose"], "subcommand": ["push"] },
          { "program": ["docker", "podman"], "any_arg": ["--push"] },
          { "program": ["docker", "podman"], "any_arg_contains": ["type=registry"] }
        ]
      }
    }
  ]
}
