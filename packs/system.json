{
  "schema_version": 1,
  "pack_version": 4,
  "tool": "system",
  "description": "System tools: privilege, permissions, scheduled jobs, services, disks, and process information.",
  "programs": [
    "sudo", "doas", "chmod", "crontab", "systemctl", "shutdown", "reboot", "killall", "dd",
    "mkfs", "fdisk", "truncate", "ps", "lsof", "date", "whoami", "uname", "df", "kill",
    "pkill", "pgrep", "id", "hostname", "uptime", "nproc", "sw_vers", "free", "vm_stat",
    "dig", "nslookup", "host"
  ],
  "rules": [
    {
      "id": "privilege",
      "flag": "privilege",
      "note": "`sudo` and `doas` run the command as another user.",
      "when": { "raw_program": ["sudo", "doas"] }
    },
    {
      "id": "process-environment",
      "flag": "secret_output",
      "note": "`ps -E` (macOS) and the BSD option letter `e` without a dash (`ps eww`, `ps auxe`) print the environment of processes, with the secrets of this run (dev round 3).",
      "when": {
        "program": ["ps"],
        "any_of": [
          { "command_contains_exact": [" -E", " -AE", " -eE", " -axE"] },
          {
            "operands": {
              "skip": ["-o", "-p", "-u", "-g", "-t", "-c"],
              "any": [{ "contains": ["e"], "only_chars": "aceghjlmnrstuvwx" }]
            }
          }
        ]
      }
    },
    {
      "id": "world-writable",
      "flag": "system_change",
      "note": "Mode `777` lets every user change the file.",
      "when": { "program": ["chmod"], "any_arg_contains": ["777"] }
    },
    {
      "id": "crontab-change",
      "flag": "system_change",
      "note": "`crontab -l` only lists the jobs.",
      "when": { "program": ["crontab"], "not": { "arg_count": 1, "subcommand": ["-l"] } }
    },
    {
      "id": "service-change",
      "flag": "system_change",
      "note": "A service change, a shutdown, or a kill of processes by name. `kill PID` sends a signal to one process; the model decides it.",
      "when": { "program": ["systemctl", "shutdown", "reboot", "killall", "pkill"] }
    },
    {
      "id": "disk-write",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "Raw writes, file systems, partitions, and truncation destroy data.",
      "when": { "program": ["dd", "mkfs", "fdisk", "truncate"] }
    }
  ],
  "safe": [
    {
      "id": "information",
      "note": "Process, time, user, host, disk, memory, and DNS information.",
      "when": {
        "program": [
          "ps", "lsof", "date", "whoami", "uname", "df", "pgrep", "id", "uptime", "nproc",
          "sw_vers", "free", "vm_stat", "dig", "nslookup", "host"
        ]
      }
    }
  ]
}
