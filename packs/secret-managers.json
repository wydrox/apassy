{
  "schema_version": 1,
  "pack_version": 3,
  "tool": "secret-managers",
  "description": "Secret managers and encryption tools (HashiCorp Vault, 1Password, Doppler, Infisical, SOPS, Chamber, Bitwarden, pass, gopass, aws-vault, age, GnuPG): commands that print or write secret values, and secret changes.",
  "programs": [
    "vault", "op", "doppler", "infisical", "sops", "chamber", "bw", "pass", "gopass",
    "aws-vault", "age", "gpg", "gpg2"
  ],
  "roles": {
    "usage": ["vault", "op", "doppler", "infisical", "sops", "chamber", "bw", "gopass", "aws-vault"],
    "command_runner": ["op", "doppler", "infisical", "chamber", "aws-vault"]
  },
  "rules": [
    {
      "id": "vault-read",
      "flag": "secret_output",
      "note": "Vault reads print secret values. `token create`, `login`, and `print token` print a token.",
      "when": {
        "program": ["vault"],
        "any_of": [
          { "subcommand": ["read"] },
          { "subcommand": ["kv"], "action": ["get"] },
          { "args_start": ["token create", "print token", "login", "write auth/"] }
        ]
      }
    },
    {
      "id": "vault-change",
      "flag": "production",
      "note": "A write, a delete, or a policy change in Vault changes secrets for every app that reads them.",
      "when": {
        "program": ["vault"],
        "any_of": [
          { "subcommand": ["write", "delete", "policy", "secrets", "auth", "operator"] },
          { "subcommand": ["kv"], "action": ["put", "patch", "delete", "destroy", "undelete", "rollback", "metadata"] }
        ]
      }
    },
    {
      "id": "vault-destroy",
      "flag": "data_loss",
      "note": "`kv destroy` and `kv metadata delete` remove secret versions for good.",
      "when": {
        "program": ["vault"],
        "subcommand": ["kv"],
        "any_of": [{ "action": ["destroy"] }, { "action": ["metadata"], "any_arg": ["delete"] }]
      }
    },
    {
      "id": "secret-values",
      "flag": "secret_output",
      "note": "The command prints secret values, or writes them to a file. `pass NAME` and `gopass NAME` show a secret, like `show`.",
      "when": {
        "any_of": [
          { "program": ["op"], "subcommand": ["read", "inject"] },
          { "program": ["op"], "subcommand": ["item", "document"], "action": ["get"] },
          { "program": ["doppler"], "subcommand": ["secrets"], "not": { "action": ["set", "delete", "upload"] } },
          { "program": ["infisical"], "subcommand": ["secrets", "export"], "not": { "action": ["set", "delete"] } },
          { "program": ["sops"], "any_arg": ["-d", "--decrypt", "exec-env", "exec-file", "decrypt"] },
          { "program": ["chamber"], "subcommand": ["read", "export", "env"] },
          { "program": ["chamber"], "subcommand": ["list"], "any_arg": ["-e", "--expand"] },
          { "program": ["bw"], "subcommand": ["get", "export"] },
          { "program": ["bw"], "subcommand": ["list"], "action": ["items"] },
          {
            "program": ["pass", "gopass"],
            "not": {
              "subcommand": [
                "ls", "list", "find", "search", "insert", "rm", "edit", "generate", "mv", "cp",
                "git", "init", "help", "version", "--help", "--version", ""
              ]
            }
          },
          { "program": ["aws-vault"], "subcommand": ["export", "login"] },
          { "program": ["age"], "any_arg": ["-d", "--decrypt"] },
          { "program": ["gpg", "gpg2"], "any_arg": ["-d", "--decrypt", "--export-secret-keys", "--export-secret-subkeys"] }
        ]
      }
    },
    {
      "id": "secret-change",
      "flag": "production",
      "note": "A change or a deletion of secrets that apps read.",
      "when": {
        "any_of": [
          { "program": ["op"], "subcommand": ["item", "document", "vault"], "action": ["create", "edit", "delete"] },
          { "program": ["doppler", "infisical"], "subcommand": ["secrets"], "action": ["set", "delete", "upload"] },
          { "program": ["chamber"], "subcommand": ["write", "delete", "import"] },
          { "program": ["bw"], "subcommand": ["create", "edit", "delete"] },
          { "program": ["pass", "gopass"], "subcommand": ["insert", "rm", "edit", "generate", "mv"] }
        ]
      }
    }
  ],
  "safe": [
    {
      "id": "status-and-names",
      "note": "Status and listings of secret names without values.",
      "when": {
        "any_of": [
          { "program": ["vault"], "subcommand": ["status", "version"] },
          { "program": ["vault"], "subcommand": ["kv"], "action": ["list"] },
          { "program": ["op"], "subcommand": ["whoami"] },
          { "program": ["op"], "subcommand": ["account"], "action": ["list", "get"] },
          { "program": ["op"], "subcommand": ["item", "vault"], "action": ["list"] },
          { "program": ["doppler"], "subcommand": ["me"] },
          { "program": ["chamber"], "subcommand": ["list", "history"], "not": { "any_arg": ["-e", "--expand"] } }
        ]
      }
    }
  ]
}
