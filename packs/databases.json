{
  "schema_version": 1,
  "pack_version": 6,
  "tool": "databases",
  "description": "Database clients and tools (psql, mysql, sqlite3, MongoDB, ClickHouse, CockroachDB, Redis, dump and restore tools): writes, drops, credential columns, schema reads, and reads of local database files.",
  "programs": [
    "psql", "pg_dump", "pg_restore", "dropdb", "dropuser", "mysql", "mysqladmin", "sqlite3",
    "duckdb", "mongo", "mongosh", "mongorestore", "clickhouse-client", "cockroach", "cqlsh",
    "redis-cli", "mysqldump", "mariadb-dump"
  ],
  "roles": {
    "usage": ["psql", "pg_dump", "pg_restore", "redis-cli", "mysqldump", "mariadb-dump"],
    "heredoc_sql": ["psql", "mysql", "sqlite3"]
  },
  "rules": [
    {
      "id": "credential-columns",
      "flag": "secret_output",
      "note": "A query that reads password hashes, tokens, or keys prints credentials.",
      "when": {
        "program": ["psql", "mysql", "sqlite3", "mongosh"],
        "command_contains": [
          "encrypted_password", "password_hash", "recovery_token", "api_key", "secret_key",
          "refresh_token", "access_token"
        ]
      }
    },
    {
      "id": "drop-database-or-user",
      "flag": "data_loss",
      "dry_run": "skip",
      "note": "`dropdb` and `dropuser` remove a database or a role.",
      "when": { "program": ["dropdb", "dropuser"] }
    },
    {
      "id": "sql-write",
      "flag": "data_loss",
      "dry_run": "skip",
      "note": "SQL that changes data, schema, or access. `-n` is an option of the client, not a dry run.",
      "when": {
        "program": [
          "psql", "mysql", "sqlite3", "mongo", "mongosh", "clickhouse-client", "cockroach",
          "cqlsh"
        ],
        "sql": "writes"
      }
    },
    {
      "id": "plain-sql-write",
      "flag": "data_loss",
      "note": "SQLite, DuckDB, and ClickHouse take SQL as a plain argument or after `--query`. SQL that changes data, schema, or access.",
      "when": { "program": ["sqlite3", "duckdb", "clickhouse-client"], "sql": "any_arg_writes" }
    },
    {
      "id": "redis-delete",
      "flag": "data_loss",
      "dry_run": "skip",
      "note": "Key and database deletion. `-n` selects the database number, it is not a dry run.",
      "when": {
        "program": ["redis-cli"],
        "any_arg": ["flushall", "flushdb", "del", "unlink", "getdel", "swapdb", "flush"]
      }
    },
    {
      "id": "redis-config-secrets",
      "flag": "secret_output",
      "note": "`CONFIG GET` with a pattern such as `*`, `requirepass`, or `masterauth` prints the server password.",
      "when": {
        "program": ["redis-cli"],
        "any_arg": ["config"],
        "operands": {
          "skip": ["-u", "-h", "-p", "-a", "-n", "--user", "--pass", "--askpass", "-s", "--sni"],
          "any": [{ "equals": ["*"] }, { "contains": ["pass", "auth"] }]
        }
      }
    },
    {
      "id": "redis-server-change",
      "flag": "system_change",
      "note": "Server settings, replication, and shutdown change the Redis server for every client.",
      "when": {
        "program": ["redis-cli"],
        "any_of": [
          { "any_arg": ["config"], "not": { "any_arg": ["get"] } },
          { "any_arg": ["shutdown", "replicaof", "slaveof", "failover", "debug"] }
        ]
      }
    },
    {
      "id": "mongo-write",
      "flag": "data_loss",
      "note": "MongoDB shell code that deletes, drops, renames, or updates many documents.",
      "when": {
        "program": ["mongo", "mongosh"],
        "any_arg_contains": [
          ".remove(", ".deletemany(", ".deleteone(", ".drop(", "dropdatabase", ".updatemany(",
          ".replaceone(", "findoneanddelete", ".dropindex", "dropuser(", "dropallusers",
          "renamecollection", ".bulkwrite("
        ]
      }
    },
    {
      "id": "restore-replaces-data",
      "flag": "data_loss",
      "note": "`pg_restore --clean` and `mongorestore --drop` drop the objects before they restore them.",
      "when": {
        "any_of": [
          { "program": ["pg_restore"], "any_arg": ["--clean", "-c"] },
          { "program": ["mongorestore"], "any_arg": ["--drop"] }
        ]
      }
    },
    {
      "id": "mysqladmin-drop",
      "flag": "data_loss",
      "note": "`mysqladmin drop` removes a database.",
      "when": { "program": ["mysqladmin"], "any_arg": ["drop"] }
    },
    {
      "id": "mysqladmin-server-change",
      "flag": "system_change",
      "note": "Shutdown and password changes affect the server and every client.",
      "when": { "program": ["mysqladmin"], "any_arg": ["shutdown", "password", "kill"] }
    }
  ],
  "safe": [
    {
      "id": "schema-reads",
      "note": "Reads of the schema, the plan of a query, or server information print no table data: `psql` meta commands such as `\\dt` and `\\d+ orders`, `EXPLAIN` of a read (also `EXPLAIN ANALYZE`, which prints only the plan), `select version()`, the MongoDB `getCollectionNames()` and `getIndexes()`, and a schema-only dump (`pg_dump --schema-only`) to the output or to a file. A query that calls a function outside a short list of read functions is not here, because a function can change data (dev round 3).",
      "when": {
        "any_of": [
          { "program": ["psql", "mongo", "mongosh", "mysql"], "sql": "schema_read" },
          { "program": ["mysqldump", "mariadb-dump"], "any_arg": ["--no-data", "-d"] },
          {
            "program": ["pg_dump"],
            "any_arg": ["--schema-only", "-s"],
            "not": { "any_arg": ["--data-only", "-a"] }
          }
        ]
      }
    },
    {
      "id": "local-file-reads",
      "note": "SQLite and DuckDB work on a local database file. SQL that only reads (`SELECT`, a read `PRAGMA` such as `integrity_check`, `.schema`, `.tables`) does not change it. A file function (`readfile`, `writefile`, `load_extension`), `-init`, and an archive mode are not reads (dev round 3).",
      "when": { "program": ["sqlite3", "duckdb"], "sql": "plain_args_read" }
    },
    {
      "id": "redis-reads",
      "note": "Redis commands that read server state, key metadata, or key names: `PING`, `INFO`, `DBSIZE`, `TTL`, `TYPE`, `EXISTS`, lengths, `SCAN`, and `MEMORY USAGE`. Connection options such as `-u URL` and `-h HOST` take a value. The value commands (`GET`, `HGETALL`) stay with the model.",
      "when": {
        "program": ["redis-cli"],
        "operands": {
          "skip": [
            "-u", "-h", "-p", "-a", "-n", "--user", "--pass", "--askpass", "-s", "--sni",
            "--cacert", "--cert", "--key", "--pattern", "--count", "-i", "-r"
          ],
          "at": {
            "index": 0,
            "in": [
              "ping", "info", "dbsize", "ttl", "pttl", "type", "exists", "strlen", "llen",
              "scard", "zcard", "hlen", "xlen", "scan", "memory", "lastsave", "time", "role",
              "slowlog", "object"
            ]
          }
        },
        "not": { "any_arg": ["reset", "doctor", "purge"] }
      }
    },
    {
      "id": "redis-scan-and-stats",
      "note": "`--scan`, `--bigkeys`, `--memkeys`, `--stat`, and latency modes list key names or measure the server.",
      "when": {
        "program": ["redis-cli"],
        "any_arg": ["--scan", "--bigkeys", "--memkeys", "--stat", "--latency", "--latency-history"],
        "operands": {
          "skip": ["-u", "-h", "-p", "-a", "-n", "--user", "--pass", "--pattern", "--count", "-i"],
          "count": 0
        }
      }
    }
  ],
  "writes": [
    {
      "id": "sql-changes",
      "note": "SQL or database shell code that changes data, schema, or access: `INSERT`, `UPDATE`, `DELETE`, `CREATE`, `ALTER`, `COPY ... FROM`, `CALL`, a MongoDB `insertOne`, and more (policy v7). The destructive statements also have the flag `data_loss`.",
      "when": {
        "any_of": [
          {
            "program": ["psql", "mysql", "mongo", "mongosh", "clickhouse-client", "cockroach", "cqlsh"],
            "sql": "changes"
          },
          { "program": ["sqlite3", "duckdb", "clickhouse-client"], "sql": "any_arg_changes" }
        ]
      }
    },
    {
      "id": "redis-writes",
      "note": "Redis commands that set, change, or remove keys, publish messages, or change the server.",
      "when": {
        "program": ["redis-cli"],
        "any_arg": [
          "set", "setex", "psetex", "setnx", "mset", "msetnx", "getset", "getdel", "getex",
          "append", "incr", "incrby", "incrbyfloat", "decr", "decrby", "del", "unlink",
          "expire", "pexpire", "expireat", "persist", "rename", "renamenx", "copy", "move",
          "hset", "hsetnx", "hmset", "hdel", "hincrby", "lpush", "rpush", "lpop", "rpop",
          "lset", "lrem", "ltrim", "linsert", "lmove", "sadd", "srem", "spop", "smove",
          "zadd", "zrem", "zincrby", "zpopmin", "zpopmax", "xadd", "xdel", "xtrim",
          "xgroup", "xack", "publish", "restore", "flushall", "flushdb", "config", "eval",
          "evalsha", "fcall", "script", "function", "save", "bgsave", "bgrewriteaof",
          "shutdown", "debug", "swapdb", "migrate", "replicaof", "slaveof", "acl"
        ]
      }
    }
  ]
}
