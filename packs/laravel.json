{
  "schema_version": 1,
  "pack_version": 2,
  "tool": "laravel",
  "description": "Laravel artisan (`php artisan`, `./artisan`, `sail artisan`) and Composer: fresh and reset migrations, database wipes, destructive tinker code, printed config, new packages, and development commands.",
  "programs": [
    "php", "artisan", "sail", "composer", "phpunit", "pest", "phpstan", "psalm", "php-cs-fixer",
    "phpcs"
  ],
  "roles": {
    "project_code": ["artisan", "sail", "composer"]
  },
  "rules": [
    {
      "id": "migrate-fresh-reset-wipe",
      "flag": "data_loss",
      "note": "`migrate:fresh` drops all tables. `migrate:reset`, `migrate:refresh`, and `migrate:rollback` revert migrations. `db:wipe` drops all tables, views, and types.",
      "when": {
        "any_of": [
          { "program": ["artisan"] },
          { "program": ["php", "sail"], "subcommand": ["artisan"] }
        ],
        "any_arg": ["migrate:fresh", "migrate:reset", "migrate:refresh", "migrate:rollback", "db:wipe"]
      }
    },
    {
      "id": "destructive-tinker-code",
      "flag": "data_loss",
      "note": "Code for `tinker` (`--execute` or a here-document) that deletes rows or runs destructive SQL.",
      "when": {
        "any_of": [
          { "program": ["artisan"] },
          { "program": ["php", "sail"], "subcommand": ["artisan"] }
        ],
        "any_arg_starts": ["tinker"],
        "segment_contains": [
          "->delete(", "::truncate(", "::destroy(", "->forcedelete(", "drop table",
          "delete from", "truncate table", "::query()->delete"
        ]
      }
    },
    {
      "id": "config-show",
      "flag": "secret_output",
      "note": "`config:show` prints config values, with database passwords and the app key.",
      "when": {
        "any_of": [
          { "program": ["artisan"] },
          { "program": ["php", "sail"], "subcommand": ["artisan"] }
        ],
        "any_arg": ["config:show"]
      }
    },
    {
      "id": "queue-flush-or-retry-all",
      "flag": "data_loss",
      "note": "`queue:flush` and `queue:forget` delete failed jobs. `queue:clear` deletes the jobs of a queue. `horizon:clear` deletes the jobs of Horizon queues.",
      "when": {
        "any_of": [
          { "program": ["artisan"] },
          { "program": ["php", "sail"], "subcommand": ["artisan"] }
        ],
        "any_arg": ["queue:flush", "queue:forget", "queue:clear", "horizon:clear", "queue:prune-failed"]
      }
    },
    {
      "id": "queue-retry",
      "flag": "irreversible",
      "note": "`queue:retry` pushes failed jobs to the queue again, with all their side effects such as emails or payments. `all` retries every failed job.",
      "when": {
        "any_of": [
          { "program": ["artisan"] },
          { "program": ["php", "sail"], "subcommand": ["artisan"] }
        ],
        "any_arg": ["queue:retry", "queue:retry-batch", "horizon:retry"]
      }
    },
    {
      "id": "app-key",
      "flag": "irreversible",
      "note": "`key:generate` replaces the application key in `.env`. Encrypted values and sessions made with the old key can no longer be read.",
      "when": {
        "any_of": [
          { "program": ["artisan"] },
          { "program": ["php", "sail"], "subcommand": ["artisan"] }
        ],
        "any_arg": ["key:generate"],
        "not": { "any_arg": ["--show"] }
      }
    },
    {
      "id": "app-key-show",
      "flag": "secret_output",
      "note": "`key:generate --show` prints a new application key.",
      "when": {
        "any_of": [
          { "program": ["artisan"] },
          { "program": ["php", "sail"], "subcommand": ["artisan"] }
        ],
        "any_arg": ["key:generate"],
        "any_arg_starts": ["--show"]
      }
    },
    {
      "id": "composer-new-package",
      "flag": "new_dependency",
      "note": "`composer require` adds a package. `global require` installs a tool.",
      "when": { "program": ["composer"], "any_arg": ["require"] }
    }
  ],
  "safe": [
    {
      "id": "artisan-development",
      "note": "Tests, route and migration listings, information, the local server, and code generators.",
      "when": {
        "any_of": [
          {
            "program": ["php", "sail"],
            "subcommand": ["artisan"],
            "any_of": [
              { "action": ["test", "route:list", "migrate:status", "list", "about", "serve", "--version", "env"] },
              { "operands": { "at": { "index": 1, "starts": ["make:"] } } }
            ]
          },
          {
            "program": ["artisan"],
            "any_of": [
              { "subcommand": ["test", "route:list", "migrate:status", "list", "about", "serve", "--version", "env"] },
              { "operands": { "at": { "index": 0, "starts": ["make:"] } } }
            ]
          }
        ]
      }
    },
    {
      "id": "composer-lockfile-and-checks",
      "note": "Installs from composer.lock, autoload, validation, and audits.",
      "when": {
        "program": ["composer"],
        "subcommand": ["install", "validate", "dump-autoload", "audit", "outdated", "show", "check-platform-reqs", "test", "lint"]
      }
    },
    {
      "id": "php-test-tools",
      "note": "PHP test, style, and static analysis tools, also through `php vendor/bin/...`.",
      "when": {
        "any_of": [
          { "program": ["phpunit", "pest", "phpstan", "psalm", "php-cs-fixer", "phpcs"] },
          {
            "program": ["php"],
            "operands": {
              "at": {
                "index": 0,
                "starts": ["vendor/bin/phpunit", "vendor/bin/pest", "vendor/bin/phpstan", "vendor/bin/psalm"]
              }
            }
          }
        ]
      }
    }
  ]
}
