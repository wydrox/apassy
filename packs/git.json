{
  "schema_version": 1,
  "pack_version": 2,
  "tool": "git",
  "description": "Git: history changes, pushes to protected branches, and read commands.",
  "programs": ["git"],
  "roles": {
    "usage": ["git"],
    "no_dry_run": ["git"]
  },
  "rules": [
    {
      "id": "secret-argument",
      "flag": "secret_output",
      "note": "A secret in a commit message, a config value, or a remote URL is stored or sent.",
      "when": { "refs_secret": true }
    },
    {
      "id": "add-force",
      "flag": "secret_output",
      "note": "`git add -f` adds ignored files, for example `.env`.",
      "when": { "subcommand": ["add"], "any_arg": ["-f", "--force"] }
    },
    {
      "id": "remote-change",
      "flag": "system_change",
      "note": "A new or changed remote changes where pushes go.",
      "when": { "subcommand": ["remote"], "any_arg": ["set-url", "add"] }
    },
    {
      "id": "global-config",
      "flag": "system_change",
      "note": "`--global` and `--system` change Git for every repository of the user.",
      "when": { "subcommand": ["config"], "any_arg": ["--global", "--system"] }
    },
    {
      "id": "reset-hard",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "`reset --hard`, `--merge`, and `--keep` discard local changes.",
      "when": { "subcommand": ["reset"], "any_arg": ["--hard", "--merge", "--keep"] }
    },
    {
      "id": "push-force-or-delete",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "A forced push, a mirror push, or a branch deletion on the remote loses commits.",
      "when": {
        "subcommand": ["push"],
        "any_of": [
          { "any_arg": ["-f", "--delete", "-d", "--mirror"] },
          { "any_arg_starts": ["--force", "+"] }
        ]
      }
    },
    {
      "id": "clean-force",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "`clean -f` deletes untracked files.",
      "when": { "subcommand": ["clean"], "option_letter": "f" }
    },
    {
      "id": "branch-delete",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "Deletion of a local branch can lose commits.",
      "when": { "subcommand": ["branch"], "any_arg": ["-d", "--delete"] }
    },
    {
      "id": "discard-changes",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "`checkout .`, `restore .`, and `-f` discard local changes.",
      "when": { "subcommand": ["checkout", "restore"], "any_arg": [".", "--force", "-f"] }
    },
    {
      "id": "stash-drop",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "`stash drop` and `stash clear` delete saved changes.",
      "when": { "subcommand": ["stash"], "any_arg": ["drop", "clear"] }
    },
    {
      "id": "history-rewrite",
      "flag": "data_loss",
      "dry_run": "skip_with_n",
      "note": "`filter-branch` and `filter-repo` rewrite the history.",
      "when": { "subcommand": ["filter-branch", "filter-repo"] }
    },
    {
      "id": "push-protected-branch",
      "flag": "production",
      "dry_run": "skip",
      "note": "A push to a release branch or of tags can start a deployment.",
      "when": {
        "subcommand": ["push"],
        "any_of": [
          { "push_target": ["main", "master", "production", "prod", "release"] },
          { "any_arg": ["--tags"] }
        ]
      }
    }
  ],
  "exemptions": [
    {
      "id": "production-word",
      "check": "production_word",
      "note": "A production word in a commit message or a log search is not a target. The push rule above checks the branch.",
      "when": {}
    }
  ],
  "safe": [
    {
      "id": "read-and-local-commands",
      "note": "Reads of the repository, and local commits and pulls.",
      "when": {
        "subcommand": [
          "status", "diff", "log", "show", "fetch", "blame", "shortlog", "describe",
          "rev-parse", "ls-files", "grep", "add", "commit", "switch", "pull", "rev-list",
          "ls-remote", "show-ref", "for-each-ref", "cat-file", "merge-base", "name-rev",
          "reflog", "count-objects", "check-ignore", "var"
        ]
      }
    },
    {
      "id": "worktree-list",
      "note": "`worktree list` only reads.",
      "when": { "subcommand": ["worktree"], "action": ["list"] }
    },
    {
      "id": "remote-read",
      "note": "Listings of remotes and their URLs.",
      "when": {
        "subcommand": ["remote"],
        "any_of": [{ "arg_count": 1 }, { "action": ["-v", "show", "get-url"] }]
      }
    },
    {
      "id": "config-read",
      "note": "Reads of the Git configuration.",
      "when": { "subcommand": ["config"], "any_arg": ["--get", "--list", "-l", "--get-all"] }
    },
    {
      "id": "stash",
      "note": "A stash saves local changes. `drop` and `clear` are not safe.",
      "when": { "subcommand": ["stash"], "not": { "any_arg": ["drop", "clear"] } }
    },
    {
      "id": "rebase",
      "note": "A plain rebase. Interactive rebases, `--exec`, and `--root` are not safe.",
      "when": {
        "subcommand": ["rebase"],
        "not": { "any_arg": ["-i", "--interactive", "--exec", "-x", "--root"] }
      }
    },
    {
      "id": "tag-list",
      "note": "`tag` without arguments lists tags.",
      "when": { "subcommand": ["tag"], "arg_count": 1 }
    },
    {
      "id": "branch",
      "note": "Listing and creation of branches. Deletion, rename, and force are not safe.",
      "when": {
        "subcommand": ["branch"],
        "not": { "any_arg": ["-d", "--delete", "-m", "--force", "-f"] }
      }
    },
    {
      "id": "checkout-branch",
      "note": "A switch to a branch, or a new branch with `-b`.",
      "when": {
        "subcommand": ["checkout"],
        "any_of": [
          { "action": ["-b"] },
          { "arg_count": 2, "operands": { "count": 2 }, "not": { "action": ["."] } }
        ]
      }
    },
    {
      "id": "push-feature-branch",
      "note": "Exactly a remote and a branch, no options, and not a release branch.",
      "when": {
        "subcommand": ["push"],
        "not": { "any_arg_starts": ["-"] },
        "operands": {
          "count": 3,
          "at": { "index": 2, "not_in": ["main", "master", "production", "prod", "release"] }
        }
      }
    }
  ]
}
