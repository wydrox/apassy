{
  "schema_version": 1,
  "pack_version": 2,
  "tool": "cloud",
  "description": "Small hosting and deploy tools (Railway, Render, Serverless, Ansible playbooks and ad-hoc commands) and Twilio. Google Cloud, Azure, Fly.io, Heroku, Firebase, Wrangler, and Stripe have their own packs.",
  "programs": ["railway", "render", "serverless", "sls", "ansible-playbook", "ansible", "twilio"],
  "roles": {
    "usage": ["twilio"]
  },
  "rules": [
    {
      "id": "platform-deploy",
      "flag": "production",
      "dry_run": "skip",
      "note": "Deployments, scaling, secrets, and removal on a hosting platform.",
      "when": {
        "program": ["railway", "render"],
        "subcommand": ["deploy", "up", "secrets", "scale", "destroy"]
      }
    },
    {
      "id": "deploy-tools",
      "flag": "production",
      "dry_run": "skip",
      "note": "Serverless and Ansible playbooks deploy or change servers.",
      "when": { "program": ["serverless", "sls", "ansible-playbook"] }
    },
    {
      "id": "ansible-ad-hoc",
      "flag": "production",
      "note": "An ad-hoc Ansible command runs a module or a shell command on remote hosts. `-m ping` and `-m setup` only check and read.",
      "when": {
        "program": ["ansible"],
        "any_of": [
          { "any_arg_starts": ["-a", "--args"] },
          { "option_value": { "option": ["-m", "--module-name"], "not_value": ["ping", "setup", "debug"] } }
        ]
      }
    }
  ],
  "safe": [
    {
      "id": "twilio-read",
      "note": "Twilio `...:list` and `...:fetch` commands only read.",
      "when": {
        "program": ["twilio"],
        "operands": { "at": { "index": 0, "starts": ["api:", "profiles:", "phone-numbers:"] } },
        "not": {
          "operands": { "any": [{ "ends": [":create", ":update", ":remove", ":delete", ":add"] }] }
        },
        "any_of": [{ "operands": { "any": [{ "ends": [":list", ":fetch"] }] } }]
      }
    }
  ]
}
