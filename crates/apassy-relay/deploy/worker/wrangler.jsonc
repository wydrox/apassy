{
  "name": "apassy-relay-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "apassy-relay.wyderka.cc", "custom_domain": true }],
  // The relay on the VPS, through the named tunnel apassy-relay (OPERATIONS.md, section 16).
  // When RELAY is bound, RELAY_ORIGIN is not used. To go back to a quick tunnel, remove
  // this binding and set RELAY_ORIGIN.
  "vpc_services": [{ "binding": "RELAY", "service_id": "01a0f70c-70ec-7882-9121-853d63b9eece", "remote": true }],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // Vault snapshot pushes (PUT /v1/sync/snapshot): each holds a relay thread for its body.
    { "name": "SYNC_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  // /guide explicitly fetches /guide.html; do not redirect that asset back to /guide.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  // APNS_KEY_ID is set by the owner before the deploy. The Worker secrets are EDGE_SECRET,
  // PUSH_SECRET, and APNS_KEY: set them with `wrangler secret put`, never in this file.
  "vars": {
    "RELAY_ORIGIN": "https://replace-me.trycloudflare.com",
    "APNS_KEY_ID": "",
    "APNS_TEAM_ID": "7S3F9767BM",
    "APNS_TOPIC": "com.wydrox.apassy.companion"
  },
  "observability": { "enabled": false }
}
