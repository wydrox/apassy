// The push gateway apassy-push (docs/contracts/push-gateway-v1.md, docs/operations/push-gateway.md).
// It stores nothing and logs nothing: no KV, D1, R2, Durable Object, Queue, or log binding, and
// observability off. The secrets are GATEWAY_KEY and APNS_KEY (and GATEWAY_KEY_PREVIOUS during a
// rotation): set them with `wrangler secret put` through Apassy, never in this file.
// A self-hoster changes the name, the route, the APNs vars, and the namespace ids.
{
  "name": "apassy-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "push.apassy.wyderka.cc", "custom_domain": true }],
  // Section 13. A Rate Limiting binding counts per 10 or 60 seconds only, so the hourly limits
  // of the contract (60 pushes per handle, 600 per node address, 30 handle creations per
  // address) are kept as per-minute caps that let a burst through and bound abuse. The keys are
  // SHA-256 of the handle text or of the client address. The namespace ids must be unique in
  // the account (the relay's edge Worker uses 1001 to 1005).
  "ratelimits": [
    { "name": "handles_per_address", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
    { "name": "pushes_per_handle", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } },
    { "name": "pushes_per_address", "namespace_id": "1103", "simple": { "limit": 100, "period": 60 } }
  ],
  "vars": {
    "GATEWAY_KEY_ID": "1",
    "APNS_KEY_ID": "2549AX5SGX",
    "APNS_TEAM_ID": "7S3F9767BM",
    "APNS_TOPIC": "com.wydrox.apassy.companion",
    "APNS_WATCH_TOPIC": "com.wydrox.apassy.companion.watchkitapp"
  },
  "observability": { "enabled": false }
}
