# The pinned inputs of the embedded tailnet node (T0 spike, ADR 0037 D9).
# One source for build.rs, scripts/install-go.sh, scripts/build-archive.sh, and
# .github/workflows/tailnet-spike.yml. Plain KEY=VALUE lines; no shell syntax.
#
# Go: the newest 1.27 patch release on 2026-11-03. The pinned libtailscale go.mod
# needs go 1.27.1 or later. Checksums from https://go.dev/dl/?mode=json&include=all.
GO_VERSION=1.27.3
GO_SHA256_DARWIN_ARM64=dd3908cf20959d798c1e06ebe5b72213f0505ce01373b40ce3110975a6cd99c2
GO_SHA256_LINUX_AMD64=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
GO_SHA256_LINUX_ARM64=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
# libtailscale (github.com/tailscale/libtailscale), commit of 2026-10-30
# "libtailscale: mark handed-out fds close-on-exec". Its go.mod requires
# tailscale.com v1.104.1. The files in go/ are copies of this commit (go/VENDORED.md).
LIBTAILSCALE_COMMIT=ac7ed43af14e19e1c1810ee9f8319872c6beb412
TAILSCALE_VERSION=1.104.1
# The minimum macOS of the app (packaging/Info.plist LSMinimumSystemVersion).
MACOS_DEPLOYMENT_TARGET=15.0
